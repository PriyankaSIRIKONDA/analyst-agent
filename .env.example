# Copy this file to .env and fill in your own keys. Never commit .env.
# Free option: a Gemini key from Google AI Studio (aistudio.google.com).
GEMINI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=

# Models in LiteLLM format: <provider>/<model>. MODEL is the default for every node;
# the others override one node each (leave empty to use MODEL).
MODEL=gemini/gemini-3.5-flash-lite
MODEL_ROUTER=
MODEL_SQL_WRITER=
MODEL_EXPLAINER=
# Tried when a node's model keeps failing, e.g. groq/llama-3.3-70b-versatile
MODEL_FALLBACK=
LLM_TIMEOUT_S=30

# Database the agent queries, and the docs file that describes it
DB_PATH=data/demo.db
DOCS_PATH=data/demo_docs.md
# Use an MCP server that is already running instead of starting one (optional)
MCP_URL=

# Conversation memory (LangGraph checkpointer). Empty = in memory, lost on restart.
# docker compose sets it for you.
DATABASE_URL=

# API keys: name:sha256 pairs. Make one with: python -m analyst_agent.security new-key alice
API_KEYS=
# true only on your own machine: accepts requests without a key
AUTH_DISABLED=false
RATE_LIMIT_PER_MINUTE=10
DAILY_QUERY_CAP=200

# Langfuse tracing (self-hosted or cloud). Empty = off.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
