# Copy this file to .env and fill in your own keys. Never commit .env.
MISTRAL_API_KEY=
GEMINI_API_KEY=

# Model name in LiteLLM format: <provider>/<model>
MODEL=mistral/mistral-small-latest

# Database the agent queries, and the docs file that describes it
DB_PATH=data/demo.db
DOCS_PATH=data/demo_docs.md
